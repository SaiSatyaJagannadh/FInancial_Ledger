# Copy to .streamlit/secrets.toml and fill in. Without this file the app runs
# in demo mode against sample data — everything works, nothing is saved.
#
# 1. Create a Google Cloud service account and download its JSON key.
# 2. Paste the JSON fields below.
# 3. Share your Google Sheet with the service account's client_email.
# 4. The first row of the sheet must be:
#       date | person | ledger | direction | amount | currency | note
#    (an empty sheet gets this header written on the first save)

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

[sheet]
url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
# or: id = "YOUR_SHEET_ID"
worksheet = "entries"

# Optional. Without it the app still runs; the attachment uploader just says
# it is not configured instead of failing halfway through a save.
# Create a Drive folder, share it with the service account as Editor, and put
# the id from its URL (drive.google.com/drive/folders/THIS_PART) here.
[drive]
folder_id = ""

# Optional. Powers the Assistant page (notes and statement images -> draft
# entries). Without it that page explains what is missing and stops.
# NVIDIA_API_KEY = "nvapi-..."

# ---------------------------------------------------------------- change emails
# Optional. Emails you a note whenever an entry or an interest charge is added,
# edited or deleted, with a field-by-field diff. Absent = off, silently.
#
# `password` is a Gmail **App Password**, not your account password:
#   myaccount.google.com/apppasswords  (needs 2-Step Verification switched on)
# It is 16 characters, usually shown in four groups. Paste it here yourself —
# never into a chat, an issue, or a commit. This file is gitignored; the
# .example you are reading is not.
#
# After filling it in, prove it works without sending anything real:
#   .venv/bin/python -m ledger.notify --test
[notify]
to = ""
password = ""
# user = ""            # defaults to `to`
# host = "smtp.gmail.com"
# port = 587

# ------------------------------------------------------------------- who can in
# Optional. Streamlit's own Google sign-in. Absent = the app is open to anyone
# who can reach it, and Streamlit's sharing list is the only gate.
#
# Create the client at console.cloud.google.com -> APIs & Services ->
# Credentials -> Create credentials -> OAuth client ID -> Web application.
# Authorised redirect URI must be exactly the redirect_uri below.
#
# cookie_secret: any long random string. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# `allowed` is the access list. An EMPTY list lets in anyone with a Google
# account, so fill it in — the app says on screen when it is unrestricted.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# deployed:    "https://family-financialledger.streamlit.app/oauth2callback"
cookie_secret = ""
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
allowed = ["saijagannadh0625@gmail.com"]

# ------------------------------------------------------- name/password accounts
# Optional, and the WEAKER of the two sign-ins. Prefer [auth] above if you can:
# it stores no passwords at all. This keeps hashes in a `users` tab of your
# workbook, which means anyone who can EDIT that sheet can add themselves a row
# and sign in as anybody. Sheet access is administrator access.
#
# Passwords are PBKDF2-HMAC-SHA256, 600,000 iterations, one random salt each —
# a reader of the sheet cannot recover a password. An editor does not need to.
#
# The first account created becomes yours; make it before sharing the app.
# signup_code, if set, is a shared word new accounts must quote. Without it
# anyone who can open the page can register.
[accounts]
enabled = false
# signup_code = ""
