# NVIDIA NIM (https://build.nvidia.com) — optional.
# Without it the app still runs: categorization falls back to rules plus a local
# heuristic, and /ai/ask returns 503 with an explanation.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified responsive. Some larger models on this endpoint accept the request
# and never reply — if AI calls start timing out, try this one first.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT_SECONDS=45

DATABASE_URL=sqlite:///./ledger.db
BASE_CURRENCY=USD
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
